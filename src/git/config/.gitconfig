[core]
	safecrlf = warn
	preloadindex = true
	fscache = true
	editor = code --wait # VS Code
	autocrlf = false
	longpaths = true
[push]
	default = simple
[credential]
	helper = manager
[remote "origin"]
	prune = true
[alias]
	add-alias = "!f() { [ $# = 3 ] && git config $1 alias.\\"$2\\" \\"$3\\" && return 0 || echo \\"Usage: git add-(local|global)-alias <new alias> <original command>\\" >&2 && return 1; }; f"
	add-global-alias = !git add-alias --global
	add-local-alias = !git add-alias --local
	aliases = !git config --get-regexp '^alias\\.' | cut -c 7- | sed 's/ / = /' | sort

	configfile = config --global -l --show-origin
	c = commit
	ci = commit
	co = checkout
	cob = checkout -b
	df = diff
	dt = difftool
	mt = mergetool
	ff = merge --ff-only
	praise = blame
	st = status

	sync = !git pull && git push

	# Forces merge from upstream master
	pu = "!git fetch origin -v; git fetch upstream -v; git merge upstream/master"
	# Merge from given branch in upstream
	mu = "!git fetch origin -v; git fetch upstream -v; git merge upstream/$1"
	# Merge from given branch in origin
	mm = "!git fetch origin -v; git merge origin/$1"
	rebase-main = "!git fetch origin -v; git rebase origin/main"
	rebase-master = "!git fetch origin -v; git rebase origin/master"

	br = branch
	branches = branch -a
	old-branch-delete = delete-old-branches
	delete-old-branches = !git fetch -p && git branch -vv | awk \"/: gone]/{print \\$1}\" | xargs git branch -D -v
	branch-name = rev-parse --abbrev-ref HEAD

	diff-branch = "!git fetch origin -v; git difftool --dir-diff $(git branch-name)"

	stashes = stash list
	snapshot = !git stash save \"snapshot: $(date)\" && git stash apply stash@{0}

	root = rev-parse --show-toplevel

	lg = log --graph --pretty=format:'%Cred%h -%C(yellow)%d%Creset %s %Cgreen(%ci) %C(bold blue)<%an>'
	lol = log --graph --decorate --pretty=oneline --abbrev-commit
	lola = log --graph --decorate --pretty=oneline --abbrev-commit --all
	llog = log --date=local
	lc = log ORIG_HEAD.. --stat --no-merges
	last = log -1 HEAD
	who = shortlog --summary --no-merges --
	whorank = shortlog --summary --numbered --no-merges
	whoemail = shortlog --summary --email --all --no-merges

	ls = ls-files
	ign = ls-files -o -i --exclude-standard
	ignored = ls-files -o -i --exclude-standard

	undo = reset --hard
	unstage = reset HEAD --
	startover = !git undo && git clean -f -d -x
	githubemail = !git config user.name 'Dale Hirt' && git config user.email 'dalehhirt@users.noreply.github.com'
	lconfig = config --local --list
	gconfig = config --global --list
	publish = !git push --set-upstream origin $(git branch-name)
	pruner = "!git prune --expire=now; git reflog expire --expire-unreachable=now --rewrite --all"
	repacker = repack -a -d -f --depth=300 --window=300 --window-memory=1g
	new = init -b main

	cp = cherry-pick

	# Worktree aliases
	wtl = worktree list

	# This shows what the path would be if we add a work tree for the given branch
	wtp = "!f() { WORKTREE_REPO_DIR=$(git worktree list | head -n 1 | cut -d ' ' -f 1)'.worktrees/'$(echo $1 | sed s,/,-,); echo $WORKTREE_REPO_DIR; }; f"

	# This adds an existing branch as a worktree.
	# Path: <main repo dir>.worktrees/<branch name>
	wta = "!f() { WORKTREE_REPO_DIR=$(git worktree list | head -n 1 | cut -d ' ' -f 1)'.worktrees/'$(echo $1 | sed s,/,-,); \
git worktree add $1 $WORKTREE_REPO_DIR; \
}; f"

	# This adds a new branch as a worktree.
	# Path: <main repo dir>.worktrees/<branch name>
	wtab = "!f() { WORKTREE_REPO_DIR=$(git worktree list | head -n 1 | cut -d ' ' -f 1)'.worktrees/'$(echo $1 | sed s,/,-,); \
git worktree add -b $1 $WORKTREE_REPO_DIR; \
}; f"

	# This adds a new branch at the given path
	wta = worktree add
	wtr = worktree remove
	wtrf = worktree remove --force

[user]
	name = Dale Hirt
[diff]
	tool = winmerge
	guitool = winmerge
[difftool "bc"]
	path = c:/Program Files/Beyond Compare 4/bcomp.exe
	cmd = \"c:/Program Files/Beyond Compare 4/bcomp.exe\" \"$LOCAL\" \"$REMOTE\"
[difftool "winmerge"]
	cmd = "'C:/Users/dhirt.MAVIS-HQ/AppData/Local/Programs/WinMerge/WinMergeU.exe'" -e -u -wl -wr "$LOCAL" "$REMOTE"
[mergetool]
	prompt = false
	keepBackup = false[merge]
	tool = winmerge
	guitool = winmerge
[mergetool "winmerge"]
    # Path must point to your WinMergeU.exe
    cmd = "'C:/Users/dhirt.MAVIS-HQ/AppData/Local/Programs/WinMerge//WinMergeU.exe'"  -e -u -dl "Local" -dr "Remote" "$LOCAL" "$REMOTE" "$MERGED"
    trustExitCode = true
[mergetool "bc"]
	path = c:/Program Files/Beyond Compare 4/bcomp.exe
	cmd = \"c:/Program Files/Beyond Compare 4/bcomp.exe\" \"$LOCAL\" \"$REMOTE\" \"$BASE\" \"$MERGED\"
[difftool]
	prompt = false
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[includeIf "gitdir/i:c:/work/"]
	path = c:/work/work.gitconfig
[includeIf "gitdir/i:c:/personal/"]
	path = c:/personal/personal.gitconfig
[includeIf "gitdir/i:d:/work/"]
	path = d:/work/work.gitconfig
[includeIf "gitdir/i:d:/personal/"]
	path = d:/personal/personal.gitconfig
[includeIf "gitdir/i:e:/work/"]
	path = e:/work/work.gitconfig
[includeIf "gitdir/i:e:/personal/"]
	path = e:/personal/personal.gitconfig
[includeIf "gitdir/i:f:/work/"]
	path = f:/work/work.gitconfig
[includeIf "gitdir/i:f:/personal/"]
	path = f:/personal/personal.gitconfig
[safe]
	directory = C:/work
	directory = C:/personal
[pull]
	rebase = false
[fetch]
	prune = false
[rebase]
	autoStash = false
	autosquash = false
	updateRefs = false

