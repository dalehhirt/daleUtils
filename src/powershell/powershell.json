	"new File script": {
		"prefix": "newFile",
		"description": "New File Script (No Azure)",
		"body": [
			"<#",
			".Description",
			"This script runs.",
			"#>",
			"[CmdletBinding(SupportsShouldProcess=\\$true)]",
			"param()",
			"begin {",
			"  \\$script:_ScriptName = '$1'",
			"",
			"  # ------------------------------",
			"  # Leave this section alone",
			"  # ------------------------------",
			"  ",
			"  \\$start = get-date",
			"  ",
			"  \\$ErrorActionPreference = 'Stop'",
			"",
			"  function Initialize-Logging() {",
			"    Set-PSFConfig -Name PSFramework.Message.Style.Prefix -Value \\$true",
			"    Set-PSFConfig -Name PSFramework.Message.Style.Prefix.Host -Value \">>> \"",
			"    Set-PSFConfig -Name PSFramework.Message.Info.Color -Value \"Green\"",
			"    \\$defaultTimeFormat = \"yyyy'-'MM'-'dd'T'HH':'mm':'sszzzz\"",
			"    Set-PSFConfig -Name PSFramework.Message.Style.TimeFormat -Value \\$defaultTimeFormat",
			"  }",
			"",
			"  function log() {",
			"    Write-PSFMessage -Level Host -Message \"\\$args\" -Target \\$env:COMPUTERNAME ",
			"  }",
			"  ",
			"  function log-error() {",
			"    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSUseApprovedVerbs', '', Justification='Log error is more accurate')]",
			"    param()",
			"  ",
			"    Write-PSFMessage -Level Error -Message \"\\$args\" -Target \\$env:COMPUTERNAME ",
			"  }",
			"  ",
			"  function log-verbose() {",
			"    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSUseApprovedVerbs', '', Justification='Log verbose is more accurate')]",
			"    param()",
			"",
			"    Write-PSFMessage -Level Verbose -Message \"\\$args\" -Target \\$env:COMPUTERNAME ",
			"  }",
			"  ",
			"  Initialize-Logging",
			"  ",
			"  # ------------------------------",
			"  # Write code starting here",
			"  # ------------------------------",
			"  log \"Starting\" \\$script:_ScriptName",
			"}",
			"process {",
			"  $2",
			"}",
			"end {",
			"  \\$end = get-date",
			"  log \"Finished\" ((\\$end - \\$start).ToString(\"hh\\h\\:mm\\m\\:ss\\s\"))",
			"",
			"  # This makes sure we wait for any lingering messages",
			"  Wait-PSFMessage",
			"}"
		]
	},
	"new Azure File script": {
		"prefix": "newAzFile",
		"description": "New File Script (With Azure)",
		"body": [
			"<#",
			".Description",
			"This script runs.",
			"#>",
			"[CmdletBinding(SupportsShouldProcess=\\$true)]",
			"param(",
			"  [Parameter(Mandatory, ParameterSetName = 'subscriptions', ValueFromPipeline)]",
			"  [object[]]\\$subscriptions,",
			"",
			"  [Parameter(Mandatory, ParameterSetName = 'subscriptionId')]",
			"  [string]\\$subscriptionId",
			")",
			"begin {",
			"  \\$script:_ScriptName = '$1'",
			"",
			"  # ------------------------------",
			"  # Leave this section alone",
			"  # ------------------------------",
			"  ",
			"  \\$start = get-date",
			"  ",
			"  \\$ErrorActionPreference = 'Stop'",
			"",
			"  function Initialize-Logging() {",
			"    Set-PSFConfig -Name PSFramework.Message.Style.Prefix -Value \\$true",
			"    Set-PSFConfig -Name PSFramework.Message.Style.Prefix.Host -Value \">>> \"",
			"    Set-PSFConfig -Name PSFramework.Message.Info.Color -Value \"Green\"",
			"    \\$defaultTimeFormat = \"yyyy'-'MM'-'dd'T'HH':'mm':'sszzzz\"",
			"    Set-PSFConfig -Name PSFramework.Message.Style.TimeFormat -Value \\$defaultTimeFormat",
			"  }",
			"",
			"  function log() {",
			"    Write-PSFMessage -Level Host -Message \"\\$args\" -Target \\$env:COMPUTERNAME ",
			"  }",
			"  ",
			"  function log-error() {",
			"    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSUseApprovedVerbs', '', Justification='Log error is more accurate')]",
			"    param()",
			"  ",
			"    Write-PSFMessage -Level Error -Message \"\\$args\" -Target \\$env:COMPUTERNAME ",
			"  }",
			"  ",
			"  function log-verbose() {",
			"    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSUseApprovedVerbs', '', Justification='Log verbose is more accurate')]",
			"    param()",
			"",
			"    Write-PSFMessage -Level Verbose -Message \"\\$args\" -Target \\$env:COMPUTERNAME ",
			"  }",
			"  ",
			"  Initialize-Logging",
			"  ",
			"  # ------------------------------",
			"  # Write code starting here",
			"  # ------------------------------",
			"  log \"Starting\" \\$script:_ScriptName",
			"  ",
			"  function Process-Subscription {",
			"    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSUseApprovedVerbs', '',",
			"      Justification='Process-Subscription is more accurate')]",
			"    [CmdletBinding(SupportsShouldProcess=\\$true)]",
			"    param(",
			"        \\$subscriptionId",
			"    )",
			"    begin {",
			"        #\\$originalAzContext = (Get-AzContext).Subscription.Id",
			"        \\$originalAzContext = ((az account show --query 'id') -replace '\"', '')",
			"        if(\\$subscriptionId -ne \\$originalAzContext) {",
			"            log \"Setting context to\" \\$subscriptionId",
			"            #Set-AzContext -Subscription \\$subscriptionId",
			"            az account set --subscription \\$subscriptionId",
			"        }",
			"    }",
			"  ",
			"    process {",
			"      $2",
			"    }",
			"",
			"    end {",
			"        if(\\$subscriptionId -ne \\$originalAzContext) {",
			"            log \"Setting context back to\" \\$originalAzContext",
			"            #Set-AzContext -Subscription \\$originalAzContext",
			"            az account set --subscription \\$originalAzContext",
			"        }",
			"    }",
			"  }",
			"}",
			"",
			"process {",
			"  if (\\$subscriptionId) {",
			"    Process-Subscription -subscriptionId \\$subscriptionId",
			"  }",
			"  else {",
			"    foreach (\\$subObject in \\$subscriptions) {",
			"      Process-Subscription -subscriptionId \\$subObject.id",
			"    }",
			"  }",
			"}",
			"",
			"end {",
			"  \\$end = get-date",
			"  log \"Finished\" ((\\$end - \\$start).ToString(\"hh\\h\\:mm\\m\\:ss\\s\"))",
			"",
			"  # This makes sure we wait for any lingering messages",
			"  Wait-PSFMessage",
			"}"
		]
	},
