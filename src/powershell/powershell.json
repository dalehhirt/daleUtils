{
	// Place your snippets for powershell here. Each snippet is defined under a snippet name and has a prefix, body and 
	// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the 
	// same ids are connected.
	// Example:
	// "Print to console": {
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
	"New Array" :{
		"prefix": "array",
		"description": "Add array",
		"body": ["$$arrayList = [System.Collections.ArrayList]@()"]
	},
	"Comment-based help" :{
		"prefix": "synopsis",
		"description": "Add comment-based help to any script or function",
		"body": ["<#",
		".Description",
		"\tThis script runs.",
		"#>"]
	},
	"Log Function" :{
		"prefix": "logit",
		"description": "Add log function",
		"body": ["function log() {",
		"  write-host \">>> [$($$env:COMPUTERNAME)]\" ((Get-Date).ToUniversalTime().ToString('u')) \"$$args\" -ForeGroundColor Green",
		"}",
		"",
	    "function log-error() {",
	    "  [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSUseApprovedVerbs', '',",
	    "    Justification='Log error is more accurate')]",
	    "  param()",
	    "",
	    "  Write-Error \">>> [$($$env:COMPUTERNAME)] $((Get-Date).ToUniversalTime().ToString('u')) $$args\"",
	    "}",
		""
		]
	},
	"new File script" : {
		"prefix": "newFile",
		"description": "New File Script (No Azure)",
		"body": [
		"<#",
		".Description",
		"This script runs.",
		"#>",
		"[CmdletBinding(SupportsShouldProcess=$$true)]",
		"param()",
		"begin {",
		"  function log() {",
		"    write-host \">>> [$($$env:COMPUTERNAME)]\" ((Get-Date).ToUniversalTime().ToString('u')) \"$$args\" -ForeGroundColor Green",
		"  }",
		"  ",
	    "  function log-error() {",
	    "    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSUseApprovedVerbs', '',",
	    "      Justification='Log error is more accurate')]",
	    "    param()",
	    "  ",
	    "    Write-Error \">>> [$($$env:COMPUTERNAME)] $((Get-Date).ToUniversalTime().ToString('u')) $$args\"",
	    "  }",
		"  ",
		"}",
		"process {",
		"\t$1",
		"}",
		"end {",
		"}"
		]
	},
	"new Azure File script" : {
		"prefix": "newAzFile",
		"description": "New File Script (With Azure)",
		"body": [
		"<#",
		".Description",
		"This script runs.",
		"#>",
		"[CmdletBinding(SupportsShouldProcess=$$true)]",
		"param(",
		"  $$subscriptionId = ''",
		")",
		"begin {",
		"  function log() {",
		"    write-host \">>> [$($$env:COMPUTERNAME)]\" ((Get-Date).ToUniversalTime().ToString('u')) \"$$args\" -ForeGroundColor Green",
		"  }",
		"  ",
	    "  function log-error() {",
	    "    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSUseApprovedVerbs', '',",
	    "      Justification='Log error is more accurate')]",
	    "    param()",
	    "  ",
	    "    Write-Error \">>> [$($$env:COMPUTERNAME)] $((Get-Date).ToUniversalTime().ToString('u')) $$args\"",
	    "  }",
		"  ",
        "  $$originalAzContext = (Get-AzContext).Subscription.Id",
		"  #$$originalAzContext = ((az account show --query 'id') -replace '\"\"', '')",
        "  if($$subscriptionId -ne $$originalAzContext) {",
		"    log \"Setting context to\" $$subscriptionId",
		"    Set-AzContext -Subscription $$subscriptionId",
		"    #az account set --subscription $$subscriptionId",
		"  }",
		"}",
		"process {",
		"  $1",
		"}",
		"end {",
        "  if($$subscriptionId -ne $$originalAzContext) {",
		"    log \"Setting context back to\" $$originalAzContext",
		"    Set-AzContext -Subscription $$originalAzContext",
		"    #az account set --subscription $$originalAzContext",
		"  }",
		"}"
		]
	}
}