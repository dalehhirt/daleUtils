	"Log Function": {
		"prefix": "logit",
		"description": "Add log function",
		"body": [
			"function log() {",
			"  write-host \">>> [$($$env:COMPUTERNAME)]\" ((Get-Date).ToUniversalTime().ToString('u')) \"$$args\" -ForeGroundColor Green",
			"}",
			"",
			"function log-error() {",
			"  [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSUseApprovedVerbs', '',",
			"    Justification='Log error is more accurate')]",
			"  param()",
			"",
			"  Write-Error \">>> [$($$env:COMPUTERNAME)] $((Get-Date).ToUniversalTime().ToString('u')) $$args\"",
			"}",
			"",
			"function log-verbose() {",
			"  [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSUseApprovedVerbs', '',",
			"    Justification='Log verbose is more accurate')]",
			"  param()",
			"",
			"  Write-Error \">>> [$($$env:COMPUTERNAME)] $((Get-Date).ToUniversalTime().ToString('u')) $$args\"",
			"}",
			""
		]
	},
	"new File script": {
		"prefix": "newFile",
		"description": "New File Script (No Azure)",
		"body": [
			"<#",
			".Description",
			"This script runs.",
			"#>",
			"[CmdletBinding(SupportsShouldProcess=$$true)]",
			"param()",
			"begin {",
			"  function log() {",
			"    write-host \">>> [$($$env:COMPUTERNAME)]\" ((Get-Date).ToUniversalTime().ToString('u')) \"$$args\" -ForeGroundColor Green",
			"  }",
			"  ",
			"  function log-error() {",
			"    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSUseApprovedVerbs', '',",
			"      Justification='Log error is more accurate')]",
			"    param()",
			"  ",
			"    Write-Error \">>> [$($$env:COMPUTERNAME)] $((Get-Date).ToUniversalTime().ToString('u')) $$args\"",
			"  }",
			"  ",
			"  function log-verbose() {",
			"    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSUseApprovedVerbs', '',",
			"      Justification='Log verbose is more accurate')]",
			"    param()",
			"    ",
			"    Write-Error \">>> [$($$env:COMPUTERNAME)] $((Get-Date).ToUniversalTime().ToString('u')) $$args\"",
			"  }",
			"  ",
			"}",
			"process {",
			"\t$1",
			"}",
			"end {",
			"}"
		]
	},
	"new Azure File script": {
		"prefix": "newAzFile",
		"description": "New File Script (With Azure)",
		"body": [
			"<#",
			".Description",
			"This script runs.",
			"#>",
			"[CmdletBinding(SupportsShouldProcess=$true)]",
			"param(",
			"  [Parameter(Mandatory, ParameterSetName = 'subscriptions', ValueFromPipeline)]",
			"  [object[]]$subscriptions,",
			"",
			"  [Parameter(Mandatory, ParameterSetName = 'subscriptionId')]",
			"  [string]$subscriptionId",
			")",
			"begin {",
			"  function log() {",
			"    write-host \">>> [$($env:COMPUTERNAME)]\" ((Get-Date).ToUniversalTime().ToString('u')) \"$args\" -ForeGroundColor Green",
			"  }",
			"  ",
			"  function log-error() {",
			"    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSUseApprovedVerbs', '',",
			"      Justification='Log error is more accurate')]",
			"    param()",
			"  ",
			"    Write-Error \">>> [$($env:COMPUTERNAME)] $((Get-Date).ToUniversalTime().ToString('u')) $args\"",
			"  }",
			"  ",
			"  function Process-Subscription {",
			"    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSUseApprovedVerbs', '',",
			"      Justification='Process-Subscription is more accurate')]",
			"    [CmdletBinding(SupportsShouldProcess=$true)]",
			"    param(",
			"        $subscriptionId",
			"    )",
			"    begin {",
			"        #$originalAzContext = (Get-AzContext).Subscription.Id",
			"        $originalAzContext = ((az account show --query 'id') -replace '\"', '')",
			"        if($subscriptionId -ne $originalAzContext) {",
			"            log \"Setting context to\" $subscriptionId",
			"            #Set-AzContext -Subscription $subscriptionId",
			"            az account set --subscription $subscriptionId",
			"        }",
			"    }",
			"  ",
			"    process {",
			"    }",
			"",
			"    end {",
			"        if($subscriptionId -ne $originalAzContext) {",
			"            log \"Setting context back to\" $originalAzContext",
			"            #Set-AzContext -Subscription $originalAzContext",
			"            az account set --subscription $originalAzContext",
			"        }",
			"    }",
			"  }",
			"}",
			"",
			"process {",
			"  if ($subscriptionId) {",
			"    Process-Subscription -subscriptionId $subscriptionId",
			"  }",
			"  else {",
			"    foreach ($subObject in $subscriptions) {",
			"      Process-Subscription -subscriptionId $subObject.id",
			"    }",
			"  }",
			"}",
			"",
			"end {",
			"",
			"}"
		]
	},
